# Copy to `.env` beside the compose file on the NAS. Never committed.

# The tag deploy-server.sh pushed. `localhost`, not the tailnet name — a
# registry stores repositories by name rather than by hostname, so it is the
# same image, and Docker accepts a registry reached over localhost on plain
# HTTP without being configured to.
DYNAMO_IMAGE=localhost:5050/dynamo:REPLACE-ME

# The Cognito refresh token. README.md, "Seeding the refresh token", has where
# it comes from and what to do when it stops working.
DYNAMO_REFRESH_TOKEN=

# Must match the role and database created in the `postgres` project.
DYNAMO_DB_PASSWORD=

# Defaults are in the compose file; override here only to change one.
# DYNAMO_INTERVAL=60
# DYNAMO_RATE=4
# DYNAMO_STALE=900
